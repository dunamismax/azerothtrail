# azerothtrail.com: installed as /etc/caddy/sites/azerothtrail.com.caddy by
# deploy/cutover.sh and loaded by the host's main Caddyfile
# (`import /etc/caddy/sites/*.caddy`), which this file never replaces.
#
# Caddy serves the active release's static dist/ directory, and proxies
# /api/* to the server-status tracker (azerothtrail-status.service on
# 127.0.0.1:4315).
# Automatic HTTPS: DNS for both names points straight at the host, so Caddy
# obtains and renews the certificates itself.
#
# Check and reload: caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

www.azerothtrail.com {
	redir https://azerothtrail.com{uri} permanent
}

azerothtrail.com {
	# The live status stream (Server-Sent Events) must not be buffered.
	@compressible not path /api/status/stream
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Everything is served from here; Astro emits no inline scripts or styles.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	root * /srv/www/azerothtrail.com/current/dist

	# Astro fingerprints everything under /_astro/, so it can be cached forever.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Pages, sw.js and version.txt change with each deploy: revalidate (cheap,
	# ETags). The API sets its own no-store.
	@fresh not path /_astro/* /api/*
	header @fresh Cache-Control "public, max-age=0, must-revalidate"

	handle /api/* {
		reverse_proxy 127.0.0.1:4315 {
			flush_interval -1
		}
	}

	handle {
		file_server
	}

	handle_errors {
		# Tracker down: JSON for the status page, which retries on its own.
		@api path /api/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			respond `{"error":"status service unavailable"}` 503
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}

	log {
		output file /var/log/caddy/azerothtrail-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
	}
}
