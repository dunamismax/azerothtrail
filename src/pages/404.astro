---
import { classes } from '../data/registry.ts';
import Layout from '../layouts/Layout.astro';
import { classPath } from '../lib/guide.ts';
---
<Layout path="/404.html" title="Page not found" description="That page isn't on the trail.">
  <section class="lost">
    <p class="lost-code" aria-hidden="true">404</p>
    <h1>Off the trail</h1>
    <p>That page doesn&rsquo;t exist. Start from the <a href="/">home page</a>, or jump to what to do at your level as a {classes.map((c, i) => <><a href={classPath(c)}>{c.name}</a>{i < classes.length - 1 ? ' or ' : ''}</>)}.</p>
  </section>
</Layout>
