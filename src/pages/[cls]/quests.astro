---
import type { GetStaticPaths } from 'astro';
import PrefsControls from '../../components/PrefsControls.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import { classes } from '../../data/registry.ts';
import type { ClassGuide, QuestStep } from '../../data/types.ts';
import Layout from '../../layouts/Layout.astro';
import { classPath, formatDate } from '../../lib/guide.ts';

export const getStaticPaths = (() => classes.map((guide) => ({ params: { cls: guide.id }, props: { guide } }))) satisfies GetStaticPaths;

const { guide } = Astro.props as { guide: ClassGuide };
const forLabel = (step: QuestStep): string | null => {
  if (!step.for) return null;
  return step.for
    .split(' ')
    .map((id) => (id === 'alliance' ? 'Alliance' : id === 'horde' ? 'Horde' : guide.races.find((r) => r.id === id)?.name ?? id))
    .join(' / ');
};
---
<Layout guide={guide} path={classPath(guide, 'quests')} title={guide.questsLabel} description={`${guide.name} ${guide.questsLabel.toLowerCase()} for World of Warcraft: Forever: where to start, the steps and travel notes.`}>
  <header class="page-head">
    <p class="eyebrow">{guide.name} · {guide.ruleset}</p>
    <h1>{guide.questsLabel}</h1>
    <p class="lead">{guide.questsLead}</p>
    <p class="verified">Last verified {formatDate(guide.lastVerified)}.</p>
  </header>

  <PrefsControls guide={guide} level={false} />
  <div class="toolbar js-only">
    <span class="small muted" data-filter-summary></span>
    <button type="button" data-toggle-show-all aria-pressed="false" hidden>Show every faction and race</button>
  </div>

  <nav aria-label="Forms">
    <ul class="bracket-index">
      {guide.forms.map((f) => <li><a href={`#${f.id}`}><b>{f.level}</b> {f.name}</a></li>)}
    </ul>
  </nav>

  {guide.forms.map((f) => (
    <article class="bracket form-card" id={f.id} aria-labelledby={`${f.id}-title`}>
      <h2 id={`${f.id}-title`}><span class="levels">{f.level}</span> {f.name} <a class="anchor" href={`#${f.id}`} aria-label={`Link to ${f.name}`}>#</a> <span class={`tag ${f.how === 'class quest' ? 'tag-accent' : ''}`}>{f.how === 'class quest' ? 'Class quest' : 'Trainer'}</span></h2>
      <p>{f.summary}</p>
      <div class="grid grid-2">
        <div>
          <p class="card-label">Use it for</p>
          <ul>{f.useFor.map((u) => <li>{u}</li>)}</ul>
        </div>
        <div>
          <p class="card-label">Key abilities</p>
          <ul class="chips">{f.keyAbilities.map((k) => <li>{k}</li>)}</ul>
        </div>
      </div>
      {f.quest && (
        <>
          <h3>{f.quest.name}</h3>
          <p class="card-label">Where to start</p>
          <ul class="steps">{f.quest.start.map((s) => <li data-for={s.for}>{forLabel(s) && <span class="tag">{forLabel(s)}</span>} {s.text}</li>)}</ul>
          <p class="card-label">Important steps</p>
          <ol class="steps">{f.quest.steps.map((s) => <li data-for={s.for}>{forLabel(s) && <span class="tag">{forLabel(s)}</span>} {s.text}</li>)}</ol>
          <p class="card-label">Travel notes</p>
          <ul class="steps">{f.quest.travel.map((s) => <li data-for={s.for}>{forLabel(s) && <span class="tag">{forLabel(s)}</span>} {s.text}</li>)}</ul>
        </>
      )}
      {f.notes && <ul>{f.notes.map((n) => <li>{n}</li>)}</ul>}
      <SourceRefs guide={guide} ids={f.sources} />
    </article>
  ))}
</Layout>
