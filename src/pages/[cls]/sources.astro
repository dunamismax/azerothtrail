---
import type { GetStaticPaths } from 'astro';
import UpdateNote from '../../components/UpdateNote.astro';
import { classes } from '../../data/registry.ts';
import type { ClassGuide } from '../../data/types.ts';
import Layout from '../../layouts/Layout.astro';
import { classPath, formatDate } from '../../lib/guide.ts';

export const getStaticPaths = (() => classes.map((guide) => ({ params: { cls: guide.id }, props: { guide } }))) satisfies GetStaticPaths;

const { guide } = Astro.props as { guide: ClassGuide };
const order = { correction: 0, update: 1, uncertain: 2, confirmed: 3 } as const;
const notes = [...guide.notes].sort((a, b) => order[a.kind] - order[b.kind] || b.date.localeCompare(a.date));
---
<Layout guide={guide} path={classPath(guide, 'sources')} title={`${guide.name} sources`} description={`References behind the ${guide.name} guide, with dated update notes.`}>
  <header class="page-head">
    <p class="eyebrow">{guide.name} · {guide.ruleset}</p>
    <h1>Sources</h1>
    <p class="lead">{guide.sourcesLead}</p>
    <p class="verified">Last verified {formatDate(guide.lastVerified)}.</p>
  </header>

  <section class="section" id="updates" aria-labelledby="updates-title">
    <h2 id="updates-title">Update notes</h2>
    <p class="small muted">Where sources disagree or a patch changed something, the note also appears next to the section it affects.</p>
    {notes.map((n) => <UpdateNote guide={guide} id={n.id} />)}
  </section>

  <section class="section" id="references" aria-labelledby="references-title">
    <h2 id="references-title">References</h2>
    <ol class="source-list">
      {guide.sources.map((s) => (
        <li id={`src-${s.id}`} class="note">
          <p class="note-title"><span class="tag">[{s.id}]</span> <a href={s.url} rel="noopener noreferrer">{s.title}</a> <span class="muted small">{s.publisher}</span></p>
          <p class="small">{s.covers}</p>
          <p class="small muted">
            {s.checked ? `Checked ${formatDate(s.checked)}` : 'Listed for reference; not rechecked for this site'}
            {s.sourceUpdated && ` · source updated ${formatDate(s.sourceUpdated)}`}
          </p>
        </li>
      ))}
    </ol>
  </section>
</Layout>
