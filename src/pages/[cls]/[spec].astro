---
import type { GetStaticPaths } from 'astro';
import GuideSectionView from '../../components/GuideSectionView.astro';
import PrefsControls from '../../components/PrefsControls.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import SpecHeader from '../../components/SpecHeader.astro';
import TalentTable from '../../components/TalentTable.astro';
import UpdateNote from '../../components/UpdateNote.astro';
import { classes } from '../../data/registry.ts';
import type { ClassGuide, SpecGuide } from '../../data/types.ts';
import Layout from '../../layouts/Layout.astro';
import { classPath, expandBuild, finalSplit, levelSpan, pointsAtLevel, runs, specPath, splitLabel, treeName } from '../../lib/guide.ts';

export const getStaticPaths = (() =>
  classes.flatMap((guide) => guide.specs.map((spec) => ({ params: { cls: guide.id, spec: spec.slug }, props: { guide, spec } })))) satisfies GetStaticPaths;

const { guide, spec } = Astro.props as { guide: ClassGuide; spec: SpecGuide };
const points = expandBuild(guide, spec.build);
const split = splitLabel(guide, finalSplit(guide, points));
const variantSplit = spec.variant ? splitLabel(guide, finalSplit(guide, expandBuild(guide, spec.build, spec.variant))) : null;
const treeHead = guide.trees.map((t) => treeName(guide, t.id)).join(' / ');
// Milestone talents: the first point of every 1-rank talent and every talent's last rank, as a quick skim.
const summary = runs(points);
const at40 = pointsAtLevel(points, 40)[0];
---
<Layout guide={guide} path={specPath(guide, spec)} title={`${spec.name} ${guide.name} leveling`} description={`${spec.name} ${guide.name} leveling guide for World of Warcraft: Forever, 10-60. ${spec.build.summary}`}>
  <SpecHeader guide={guide} spec={spec} endgame={false} title={`${spec.name} ${guide.name} leveling guide`} lead={spec.lead} />

  <div class="grid grid-2 pros-cons">
    <div class="card">
      <p class="card-label">Strengths</p>
      <ul>{spec.strengths.map((s) => <li>{s}</li>)}</ul>
    </div>
    <div class="card">
      <p class="card-label">Weaknesses</p>
      <ul>{spec.weaknesses.map((s) => <li>{s}</li>)}</ul>
    </div>
  </div>

  <nav class="toc" aria-label="On this page">
    <p class="card-label">On this page</p>
    <ul>
      <li><a href="#build">Talent order</a></li>
      {spec.variant && <li><a href="#variant">{spec.variant.title}</a></li>}
      <li><a href="#talent-notes">Talent notes</a></li>
      {spec.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      <li><a href="#dual-spec">Second spec at 40</a></li>
    </ul>
  </nav>

  <PrefsControls guide={guide} spec={false} faction={false} />
  {spec.notes?.map((id) => <UpdateNote guide={guide} id={id} />)}

  <section class="section" id="build" aria-labelledby="build-title">
    <h2 id="build-title">Every talent point, 10 to 60</h2>
    <p>{spec.build.summary} <span class="tag tag-accent">{treeHead}: {split}</span></p>
    <p class="js-only small">Your level is highlighted. <a href="#build" data-jump-level="tr">Jump to level <span data-level-text>1</span></a>.</p>

    <details class="callout">
      <summary><b>Summary by level</b></summary>
      <ul class="columns">{summary.map((r) => <li><b>{levelSpan(r.from.level, r.to.level)}</b> {r.from.talent.name} {r.from.rank === r.to.rank ? `${r.to.rank}` : `${r.from.rank}-${r.to.rank}`}/{r.to.talent.maxRank} <span class="muted small">({treeName(guide, r.from.talent.tree)})</span></li>)}</ul>
    </details>

    <TalentTable guide={guide} build={spec.build} caption={`${spec.build.name} talent order`} />
    <SourceRefs guide={guide} ids={spec.build.sources} />

    {spec.variant && (
      <div class="note note-update" id="variant">
        <p class="note-title">{spec.variant.title} <span class="tag tag-accent">{variantSplit}</span></p>
        <p>{spec.variant.body}</p>
        <SourceRefs guide={guide} ids={spec.variant.sources} />
      </div>
    )}

    <h3 id="talent-notes">Talent notes</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Talent</th><th scope="col">Tree, row</th><th scope="col">What it does</th></tr></thead>
        <tbody>
          {[...new Map(points.map((p) => [p.talent.id, p.talent])).values()].map((t) => (
            <tr><th scope="row">{t.name}</th><td class="nowrap">{treeName(guide, t.tree)}, {t.row}</td><td>{t.summary}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">Row n unlocks at 5 &times; (n &minus; 1) points in that tree. &ldquo;(Classic)&rdquo; marks an effect carried over from Classic that Forever sources don&rsquo;t restate.</p>
  </section>

  {spec.sections.map((s) => <GuideSectionView guide={guide} section={s} />)}

  <section class="section" id="dual-spec" aria-labelledby="dual-spec-title">
    <h2 id="dual-spec-title">Your second spec at 40</h2>
    <p>Dual Specialization unlocks at 40 from a class trainer in a major city, where talent changes also happen. Your second slot starts empty: spend its points in another spec’s order up to your level{at40 ? `, so 31 points at 40` : ''}, then one per level.</p>
    <ul>{spec.dualSpec.map((d) => <li>{d}</li>)}</ul>
    <p class="small"><a href={classPath(guide, 'specs')}>Compare every {guide.name} spec</a></p>
  </section>

  <nav class="pager" aria-label="Next">
    <a class="button" href={classPath(guide)}>&larr; What to do at my level</a>
    <a class="button button-accent" href={specPath(guide, spec, true)}>{spec.name} at level 60 &rarr;</a>
  </nav>
</Layout>
