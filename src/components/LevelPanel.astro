---
import type { ClassGuide, SpecGuide, TrainSpell } from '../data/types.ts';
import { FACTIONS, FACTION_LABEL, ROLE_LABEL } from '../data/types.ts';
import { dungeonZoneName, worldDungeons } from '../data/world/index.ts';
import {
  FIRST_TALENT_LEVEL,
  MAX_LEVEL,
  bracketFor,
  bracketHref,
  catchUpRank,
  classPath,
  dungeonsForLevel,
  expandBuild,
  formsAt,
  levelSpan,
  nextForm,
  nextTrainingFor,
  pointsAtLevel,
  rangeLabel,
  rangeSourceLabel,
  specPath,
  splitLabel,
  trainingAt,
  trainingFor,
  treeName,
  type SpecTraining,
} from '../lib/guide.ts';

interface Props {
  guide: ClassGuide;
  level: number;
  /** Render as a hidden panel for the home page switcher. */
  switcher?: boolean;
  visible?: boolean;
}

const { guide, level, switcher = false, visible = true } = Astro.props;
const bracket = bracketFor(guide, level);
const trainNow = trainingAt(guide, level);
const questsNow = formsAt(guide, level);
const questNext = nextForm(guide, level);
const dungeons = dungeonsForLevel(guide, level);
const milestone = guide.milestones.find((m) => m.level === level);
const nextMilestone = guide.milestones.find((m) => m.level > level);
const branches = bracket.raceBranches;
const spellName = (s: TrainSpell) => `${s.name}${s.rank ? ` ${s.rank}` : ''}`;
const statusTag = { 'in-range': ['tag-ok', 'In range'], below: ['tag-warn', 'Below range'], above: ['tag', 'Above range'], unknown: ['tag', 'Range not published'] } as const;
const zonesHref = `/zones/?level=${level}`;
// Every other dungeon whose levels include this one, from the full list.
const alsoInRange = worldDungeons.filter((d) => level >= d.levels[0] && level <= d.levels[1] && !dungeons.some((p) => p.dungeon.id === d.id));
const headingId = `panel-${level}-title`;
const total = MAX_LEVEL - FIRST_TALENT_LEVEL + 1;
const treeNames = guide.trees.map((t) => t.name).join(' / ');

// One talent card per spec.
const talentCards = guide.specs.map((spec) => {
  const points = expandBuild(guide, spec.build);
  return {
    spec,
    first: pointsAtLevel(points, FIRST_TALENT_LEVEL)[0],
    point: pointsAtLevel(points, level)[0],
    next: pointsAtLevel(points, level + 1)[0],
    catchUp: catchUpRank(guide, spec, level),
  };
});

// Trainer lists, grouped so specs that train the same things share one block.
type TrainBlock = { specs: SpecGuide[]; now: SpecTraining | null; next: { level: number; training: SpecTraining } | undefined };
const trainBlocks: TrainBlock[] = [];
for (const spec of guide.specs) {
  const now = trainNow ? trainingFor(guide, spec, trainNow) : null;
  const next = nextTrainingFor(guide, spec, level);
  const key = JSON.stringify([now, next]);
  const same = trainBlocks.find((b) => JSON.stringify([b.now, b.next]) === key);
  if (same) same.specs.push(spec);
  else trainBlocks.push({ specs: [spec], now, next });
}
const specIds = (specs: SpecGuide[]) => specs.map((s) => s.slug).join(' ');
const specNames = (specs: SpecGuide[]) => specs.map((s) => s.name).join(', ');
const allSpecs = (specs: SpecGuide[]) => specs.length === guide.specs.length;
const nextList = (t: SpecTraining) => t.core.map(spellName).join(', ') || 'optional ranks only';
---
<section class="panel" data-level-panel={switcher ? String(level) : undefined} hidden={switcher && !visible ? true : undefined} aria-labelledby={headingId}>
  <div class="panel-head">
    <h2 id={headingId}>Level {level}</h2>
    <a class="tag tag-accent" href={bracketHref(guide, bracket)}>Questing bracket {levelSpan(bracket.min, bracket.max)}: {bracket.title}</a>
    {milestone && <span class="tag tag-ok">Milestone: {milestone.text}</span>}
  </div>

  <div class="grid">
    <div class="card card-talent">
      <p class="card-label">Talent point</p>
      {talentCards.map(({ spec, first, point, next, catchUp }) => (
        <div class={`spec-block role-${spec.role}`} data-spec={spec.slug}>
          <p class="spec-name"><span class={`tag role-${spec.role}`}>{spec.name} · {ROLE_LABEL[spec.role]}</span></p>
          {level < FIRST_TALENT_LEVEL ? (
            <p>Talents start at {FIRST_TALENT_LEVEL}. Your first point goes into <b>{first?.talent.name}</b> ({treeName(guide, first?.talent.tree ?? '')}).</p>
          ) : point ? (
            <>
              <p class="big">{point.talent.name} <span class="muted">{point.rank}/{point.talent.maxRank}</span></p>
              <progress class="points" value={point.n} max={total} aria-label={`Talent points spent: ${point.n} of ${total}`}></progress>
              <p class="small muted">{treeName(guide, point.talent.tree)} · point {point.n} of {total} · split now {splitLabel(guide, point.totals)} ({treeNames})</p>
              <p class="small">{point.talent.summary}</p>
              {catchUp && <p class="small"><b>Also train:</b> {spellName(catchUp)}. The trainer already sells it.</p>}
              {next && <p class="small">Next at {next.level}: <b>{next.talent.name}</b> {next.rank}/{next.talent.maxRank}.</p>}
            </>
          ) : null}
          <p class="small"><a href={`${specPath(guide, spec)}#lvl-${Math.max(level, FIRST_TALENT_LEVEL)}`}>Full {spec.name} order</a>{level >= 55 && <> · <a href={specPath(guide, spec, true)}>{spec.name} at 60</a></>}</p>
        </div>
      ))}
      {level >= 40 && <p class="small muted">Second spec: follow another spec’s build up to your level. <a href={classPath(guide, 'specs')}>Compare specs</a>.</p>}
    </div>

    <div class="card">
      <p class="card-label">Where to quest</p>
      {FACTIONS.map((f) => {
        const route = bracket[f];
        return (
          <div class="faction-col" data-for={f}>
            <h3><span class={`tag tag-${f}`}>{FACTION_LABEL[f]}</span></h3>
            <p>{route.primary}</p>
            {route.hubs.length > 0 && <ul class="chips" aria-label="Hubs">{route.hubs.map((h) => <li>{h}</li>)}</ul>}
            {route.alternatives.length > 0 && <p class="small"><b>Alternative:</b> {route.alternatives.join('; ')}.</p>}
            {route.travel.length > 0 && <p class="small muted"><b>Travel:</b> {route.travel.join(' ')}</p>}
          </div>
        );
      })}
      {branches.map((b) => (
        <div class="branch" data-for={b.races}>
          <h4>{b.title}{b.uncertain && <span class="tag tag-uncertain">Unconfirmed</span>}</h4>
          <ul>{b.steps.map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
      <p class="small"><a href={bracketHref(guide, bracket)}>Full {levelSpan(bracket.min, bracket.max)} route, travel and notes</a> · <a href={zonesHref}>Every zone and dungeon for level {level}</a></p>
    </div>

    <div class="card">
      <p class="card-label">Trainer and class quests</p>
      {questsNow.map((f) => (
        <p class="big"><a href={`${classPath(guide, 'quests')}#${f.id}`}>{f.name}</a> {f.how === 'class quest' ? <span class="tag tag-accent">Class quest now</span> : <span class="tag tag-accent">At the trainer</span>}</p>
      ))}
      {trainBlocks.map((b) => (
        <div class="spec-block" data-spec={specIds(b.specs)}>
          {!allSpecs(b.specs) && <p class="spec-name spec-group-name"><span class="tag">{specNames(b.specs)}</span></p>}
          {b.now && (b.now.core.length + b.now.situational.length + b.now.defer.length) > 0 ? (
            <>
              <h3>Train at {level}</h3>
              <ul class="spells">
                {b.now.core.map((s) => <li><b>{spellName(s)}</b>{s.talent && <span class="tag">Talent</span>}{s.note && <span class="why">{s.note}</span>}</li>)}
                {b.now.situational.map((s) => <li>{spellName(s)} <span class="why">if you use it{s.note ? `. ${s.note}` : ''}</span></li>)}
              </ul>
              {b.now.defer.length > 0 && <p class="small muted">Can wait if gold is tight: {b.now.defer.map(spellName).join(', ')}.</p>}
              {b.next && <p class="small muted">Next visit at {b.next.level}: {nextList(b.next.training)}.</p>}
            </>
          ) : (
            <p>No new training at {level}.{b.next && <> Next trainer visit at <b>{b.next.level}</b>: {nextList(b.next.training)}.</>}</p>
          )}
        </div>
      ))}
      {questNext && <p class="small">Next class unlock: <a href={`${classPath(guide, 'quests')}#${questNext.id}`}>{questNext.name}</a> at {questNext.level} ({questNext.how}).</p>}
    </div>

    <div class="card">
      <p class="card-label">Dungeon nearby <span class="tag tag-optional">Optional</span></p>
      {dungeons.length === 0 && alsoInRange.length === 0 ? (
        <p>No dungeon worth the trip yet. Keep questing; the first dungeons open at 13.</p>
      ) : dungeons.length === 0 ? null : (
        <ul class="spells">
          {dungeons.map(({ dungeon, note, status }) => (
            <li>
              <b>{dungeon.name}</b>
              <span class="tag">{rangeSourceLabel(dungeon)} {rangeLabel(dungeon)}</span>
              <span class={`tag ${statusTag[status][0]}`}>{statusTag[status][1]}</span>
              {dungeon.easierFor && <span class={`tag tag-${dungeon.easierFor}`}>Easier {FACTION_LABEL[dungeon.easierFor]} access</span>}
              <span class="why">{dungeon.zone}. {note}{dungeon.access ? ` ${dungeon.access}` : ''}</span>
            </li>
          ))}
        </ul>
      )}
      {alsoInRange.length > 0 && (
        <p class="small"><b>{dungeons.length === 0 ? `In range at ${level}` : 'Also in range'}:</b> {alsoInRange.map((d, i) => (
          <><a href={`/zones/#dungeon-${d.id}`}>{d.name}</a> <span class="muted">{d.levels[0]}-{d.levels[1]}, {dungeonZoneName(d)}{d.easierFor ? `, easier for ${FACTION_LABEL[d.easierFor]}` : ''}</span>{i < alsoInRange.length - 1 ? '; ' : '.'}</>
        ))}</p>
      )}
      <p class="small"><a href={zonesHref}>Every zone and dungeon for level {level}</a></p>
      {nextMilestone && <p class="small muted">Coming up at {nextMilestone.level}: {nextMilestone.text}</p>}
    </div>
  </div>

  <div class="callout">
    <p class="card-label">Plan for {levelSpan(bracket.min, bracket.max)}</p>
    <ul>{bracket.plan.map((p) => <li>{p}</li>)}</ul>
    {guide.specs.map((spec) => (
      <div class="spec-block" data-spec={spec.slug}>
        <p class="spec-plan-label"><span class={`tag role-${spec.role}`}>As {spec.name}</span></p>
        <ul>{(bracket.specPlan[spec.slug] ?? []).map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}
  </div>
</section>
