---
import '../styles/global.css';
import type { ClassGuide } from '../data/types.ts';
import { classes } from '../data/registry.ts';
import { classPath, formatDate, specPath } from '../lib/guide.ts';

interface Props {
  title: string;
  description: string;
  /** The class this page belongs to. Omit on pages for every class (home, 404). */
  guide?: ClassGuide;
  /** Path of this page, for aria-current and the canonical URL. */
  path: string;
  canonical?: string;
  pageLevel?: number;
  /** Link the web app manifest (the status page, so it can be installed for push on iOS). */
  manifest?: boolean;
}

const { title, description, guide, path, canonical, pageLevel, manifest } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const nav = guide
  ? [
      { href: classPath(guide), label: 'My level', exact: true },
      { href: classPath(guide, 'route'), label: 'Route', exact: false },
      { href: classPath(guide, 'quests'), label: guide.questsNav, exact: false },
      { href: classPath(guide, 'specs'), label: 'Specs', exact: false },
      { href: classPath(guide, 'sources'), label: 'Sources', exact: false },
    ]
  : [];
const fullTitle = title === 'Azeroth Trail' ? title : `${title} · Azeroth Trail`;
const lastVerified = classes.map((c) => c.lastVerified).sort().at(-1) ?? '';
---
<!doctype html>
<html lang="en" data-class={guide?.id} data-specs={guide?.specs.map((s) => s.slug).join(' ')} data-default-spec={guide?.defaultSpec}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${canonical ?? path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/spec-filter.css" />
    {manifest && <link rel="manifest" href="/manifest.json" />}
    {manifest && <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />}
    <meta name="theme-color" content="#12100c" media="(prefers-color-scheme: dark)" data-theme-color="dark" />
    <meta name="theme-color" content="#f5efe1" media="(prefers-color-scheme: light)" data-theme-color="light" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}${canonical ?? path}`} />
    <meta property="og:site_name" content="Azeroth Trail" />
    <meta property="og:image" content={`${site}/icons/status-512.png`} />
    <meta name="twitter:card" content="summary" />
    <script is:inline src="/boot.js"></script>
  </head>
  <body data-class={guide?.id} data-page-level={pageLevel}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-top">
        <a class="brand" href="/"><span class="mark" aria-hidden="true">&#10022;</span> Azeroth Trail <small>WoW Forever leveling</small></a>
        <nav class="class-switch" aria-label="Class guides and server status">
          <ul>
            {classes.map((c) => <li><a href={classPath(c)} data-class={c.id} aria-current={c.id === guide?.id ? 'true' : undefined}>{c.name}</a></li>)}
            <li><a href="/zones/" aria-current={path === '/zones/' ? 'page' : undefined}><span class="nav-long">Where to level</span><span class="nav-short">Zones</span></a></li>
            <li class="status-link-item"><a class="status-link" href="/status/" aria-current={path === '/status/' ? 'page' : undefined}><span class="status-dot" data-status-dot aria-hidden="true"></span><span>Server status</span></a></li>
          </ul>
        </nav>
        <button type="button" class="theme-toggle js-only" data-theme-toggle aria-label="Theme: follows your device"><span class="theme-glyph" aria-hidden="true"></span><span data-theme-label>Auto</span></button>
      </div>
    </header>
    {guide && (
      <div class="subnav">
        <div class="wrap header-nav">
          <nav class="site-nav" aria-label={`${guide.name} guide`}>
            <ul>
              {nav.map((item) => (
                <li><a href={item.href} aria-current={(item.exact ? path === item.href : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <nav class="spec-nav" aria-label={`${guide.name} specs`}>
            <ul>
              {guide.specs.map((s) => (
                <li><a href={specPath(guide, s)} data-spec-link={s.slug} aria-current={path.startsWith(specPath(guide, s)) ? 'page' : undefined}>{s.name}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    )}
    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Azeroth Trail: a World of Warcraft: Forever leveling guide for every spec. {guide ? `${guide.name} guide last verified ${formatDate(guide.lastVerified)}.` : `Last verified ${formatDate(lastVerified)}.`} Written for Forever; most of it also holds for WoW Classic, except Forever’s new talents, spells, zones and dungeons.</p>
        <p>Unofficial fan guide, not affiliated with Blizzard Entertainment. Preferences are stored only in this browser.</p>
      </div>
    </footer>
    {guide && (
      <div hidden>
        {guide.races.map((r) => <span data-race-id={r.id} data-race-name={r.name} data-faction={r.faction}></span>)}
        {guide.specs.map((s) => <span data-spec-id={s.slug} data-spec-name={s.name}></span>)}
      </div>
    )}
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
